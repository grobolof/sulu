# =============================================================================
# КОНФИГУРАЦИЯ PHPSTAN
# =============================================================================
# Этот файл настраивает статический анализ PHP-кода
# =============================================================================

parameters:

    # =========================================================================
    # УРОВЕНЬ АНАЛИЗА
    # =========================================================================

    # Уровень строгости анализа (0-9 или max)
    # 0 - минимальный, 9 - очень строгий, max - максимальный
    level: 5

    # =========================================================================
    # ПУТИ ДЛЯ АНАЛИЗА
    # =========================================================================

    # Директории с кодом для анализа
    paths:
        - src

    # =========================================================================
    # ИСКЛЮЧЕНИЯ
    # =========================================================================

    # Директории, которые нужно пропустить при анализе
    excludePaths:
        - vendor
        - var

    # =========================================================================
    # НАСТРОЙКИ ОТЧЕТОВ
    # =========================================================================

    # reportUnmatchedIgnoredErrors - сообщать о неиспользуемых игнорированиях
    reportUnmatchedIgnoredErrors: false

    # =========================================================================
    # ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
    # =========================================================================

    # tmpDir - временная директория для кэша
    tmpDir: var/phpstan

    # parallel - параллельная обработка
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 60.0
        minimumNumberOfJobsPerProcess: 2
        buffer: 134217728

    # treatPhpDocTypesAsCertain - считать типы из PHPDoc достоверными
    treatPhpDocTypesAsCertain: false
